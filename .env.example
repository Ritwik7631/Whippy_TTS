# Whippy API base URL (no trailing slash, no /api suffix)
# Local dev: http://localhost:4000
# Colab + local API: use your temporary Cloudflare Tunnel URL, e.g.
# https://your-subdomain.trycloudflare.com
WHIPPY_BASE_URL=

# Whippy dashboard access token from login/session.
# Sent as the raw `authorization` header (not Bearer).
WHIPPY_API_KEY=

# Agent UUID to chat with
WHIPPY_AGENT_ID=

# Organization UUID for the `organization_id` header
WHIPPY_ORGANIZATION_ID=

# Optional reference values (not sent in the basic hello request)
WHIPPY_USER_ID=
WHIPPY_CHANNEL_ID=
